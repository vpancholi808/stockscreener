# SEC requires a real name and email on every request
EDGAR_USER_AGENT="Your Name you@email.com"

# sqlite:///finmodel_web.db  for local dev
# postgresql://user:pass@host:5432/finmodel  for production
DATABASE_URL=sqlite:///finmodel_web.db

# Serve price-derived fields (market cap, P/E, EV/EBITDA)?
# Only set true with a price feed licensed for redistribution.
SERVE_MARKET_DATA=false

RATE_LIMIT_PER_MIN=120
ALLOWED_ORIGINS=http://localhost:3000
